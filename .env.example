# Chain (defaults to a local anvil node)
MONAD_RPC_URL=http://127.0.0.1:8545
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=
JUDGE_PRIVATE_KEY=
# Optional; otherwise read from .deployments/<chainId>.json
DEAD_POOL_ADDRESS=

# Judge
JUDGE_ENGINE=auto            # auto | claude-cli | anthropic | heuristic | mock
JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=           # only for JUDGE_ENGINE=anthropic
GITHUB_TOKEN=                # optional; falls back to `gh auth token`
JUDGE_LOOKBACK_DAYS=90
JUDGE_MIN_MEANINGFUL_COMMITS=3
JUDGE_MIN_ACTIVE_DAYS=2
JUDGE_ALLOW_FIXTURES=0       # 1 lets fixture:// repos be judged (demo/tests)
JUDGE_API_PORT=8787

# Seed overrides
DEMO_ALIVE_REPO=
DEMO_DEAD_REPO=
DEMO_ZOMBIE_REPO=
OWN_REPO_URL=

# Web (put these in web/.env.local)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_MONAD_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DEAD_POOL_ADDRESS=
NEXT_PUBLIC_DEMO_POOL_ID=0
NEXT_PUBLIC_JUDGE_API_URL=http://localhost:8787
